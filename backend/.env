# SmartWatt Backend – Environment Variables
# Copy this to .env and fill in your values

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=energy-monitoring-system
DB_POOL_SIZE=10

SECRET_KEY=change-this-to-a-long-random-string-in-production
TOKEN_EXPIRE_MINUTES=480

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500,null
